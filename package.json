{
  "name": "ai-eponym-atlas",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "A structured atlas of mathematical and AI concepts named after people.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "tsc -b --pretty false",
    "lint:docs": "markdownlint-cli2",
    "links:check": "node scripts/check-source-links.mjs",
    "portraits:audit": "node scripts/audit-portrait-candidates.mjs",
    "test": "vitest",
    "portraits:sync": "node scripts/sync-portrait-assets.mjs",
    "preview": "vite preview",
    "check": "npm run lint && npm run lint:docs && npm test -- --run && npm run build"
  },
  "dependencies": {
    "katex": "^0.18.1",
    "lucide-react": "^1.28.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "markdownlint-cli2": "^0.23.2",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20.19"
  }
}
