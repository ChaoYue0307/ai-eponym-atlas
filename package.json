{
  "name": "ai-eponym-atlas",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "description": "An atlas of mathematical and technical eponyms used in or foundational to AI.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/generate-static-pages.mjs && node scripts/check-generated-seo.mjs && node scripts/check-bundle-budget.mjs",
    "typecheck": "tsc -b --pretty false",
    "lint": "npm run typecheck",
    "lint:docs": "markdownlint-cli2",
    "links:check": "node scripts/check-source-links.mjs",
    "portraits:audit": "node scripts/audit-portrait-candidates.mjs",
    "test": "vitest",
    "portraits:sync": "node scripts/sync-portrait-assets.mjs",
    "preview": "vite preview",
    "check": "npm run typecheck && npm run lint:docs && npm test -- --run && npm run build"
  },
  "dependencies": {
    "katex": "^0.18.7",
    "lucide-react": "^1.44.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.0.5",
    "markdownlint-cli2": "^0.23.2",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20.19"
  }
}
